# Normalize line endings to LF in the repo regardless of the checkout OS,
# so Windows (CRLF-by-default) and Linux (CI) contributors don't produce
# noisy line-ending-only diffs.
* text=auto eol=lf

# Binary-ish assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
